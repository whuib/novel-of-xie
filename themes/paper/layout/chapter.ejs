<%
const chapters = site.pages.toArray().filter(item => item.layout === 'chapter').sort((a, b) => Number(a.order) - Number(b.order));
const current = chapters.findIndex(item => item.path === page.path);
const previous = current > 0 ? chapters[current - 1] : null;
const next = current >= 0 ? chapters[current + 1] : null;
%>
<div class="reading-progress" role="progressbar" aria-label="本章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="progress-fill"></span></div>
<article class="chapter-page" data-chapter-order="<%= page.order %>">
  <header class="chapter-heading"><a class="back-link" href="<%- url_for('/chapters/') %>">← 返回目录</a><p class="eyebrow"><%= page.kind === 'extra' ? '番外篇' : '正文 · ' + String(page.chapter_number).padStart(2, '0') %></p><h1><%= page.title %></h1><div class="chapter-rule" aria-hidden="true">✦</div></header>
  <div class="reader-toolbar" aria-label="阅读设置"><span>阅读设置</span><div class="toolbar-controls"><button type="button" class="font-decrease" aria-label="缩小字体">A−</button><span class="font-size-value" aria-live="polite">18</span><button type="button" class="font-increase" aria-label="放大字体">A+</button><span class="toolbar-divider" aria-hidden="true"></span><button type="button" class="line-height-toggle" aria-label="调整行距">行距 <span class="line-height-value">舒适</span></button></div></div>
  <div class="chapter-content" id="chapter-content"><%- page.content %></div>
  <nav class="chapter-nav" aria-label="章节导航"><% if (previous) { %><a class="nav-previous" href="<%- url_for(previous.path) %>"><span>← 上一篇</span><strong><%= previous.title %></strong></a><% } else { %><span></span><% } %><% if (next) { %><a class="nav-next" href="<%- url_for(next.path) %>"><span>下一篇 →</span><strong><%= next.title %></strong></a><% } else { %><a class="nav-next" href="<%- url_for('/chapters/') %>"><span>已读完</span><strong>返回目录 →</strong></a><% } %></nav>
  <div class="chapter-end"><a href="<%- url_for('/chapters/') %>">查看全部章节</a></div>
</article>
